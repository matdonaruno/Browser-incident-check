{
  "manifest_version": 3,
  "name": "入力監査ログ (Input Audit)",
  "version": "0.4.0",
  "description": "ブラウザでの入力・貼り付け・送信を、既定はメタデータのみ、許可したサイトでは入力値・修正履歴・送信時スナップショットも記録するローカル監査ツール。許可サイトでは送信前ゲート（内容の一覧表示と確認）と L1 ルール検査（未入力・全角・貼り付け異常などの警告）、L2 元データ照合（サイドパネルに取り込んだ元データとの突き合わせ）と復元アシストも行う。",
  "permissions": ["storage", "activeTab", "sidePanel"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["detect.js", "rules.js", "collate.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "入力監査ログ",
    "default_popup": "popup/popup.html"
  }
}
